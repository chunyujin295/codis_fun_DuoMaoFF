# 数据库
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000/DuoMaoFF/api/auth"

# 管理员账号
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123"

# 上传配置
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=52428800
# 公网代理也需要设置相匹配的上传大小和超时。Docker 中 UPLOAD_DIR 固定为 /app/uploads。
# Docker 推荐 DATABASE_URL="file:/app/prisma/dev.db"；升级旧部署前先核查实际数据库位置。
